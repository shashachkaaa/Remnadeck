# Этот файл заполняет install.sh и сама панель (мастер первого входа и раздел «Настройки»).
PANEL_DOMAIN=deck.example.com
PANEL_PORT=8090
# Домен публичной статус-страницы (задаётся в разделе «Статус-страница»). На нём админка недоступна
STATUS_DOMAIN=
# Домен подписок, который Caddy отдаёт в RemnaDeck (раздел «Прослойка подписок»)
SUB_DOMAIN=
SUB_UPSTREAM=http://remnawave-subscription-page:3010
SECRET_KEY=
# CRYPT_KEY шифрует SSH-доступы к серверам нод. Меняешь — теряешь сохранённые пароли и ключи
CRYPT_KEY=
SETUP_TOKEN=

REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_TOKEN=
REMNAWAVE_INTERNAL=auto
REMNAWAVE_VERIFY_TLS=true

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

SSH_TIMEOUT=20
POLL_INTERVAL=60
CHECK_INTERVAL=300
TG_BOT_TOKEN=
TG_CHAT_ID=
